<?xml version="1.0" encoding="UTF-8"?>
<!--
  BR-COM-10-01 fail fixture (TED Prior Information Notice).
  A TED_PIN reference whose ID matches neither the new eForms/TED publication
  number scheme (NNNNNNNN-YYYY) nor the legacy OJ S scheme (YYYY/S NNN-NNNNNN).
  The rule MUST fire (flag="fatal"). Here the numeric part exceeds 8 digits.
-->
<QualificationApplicationRequest
    xmlns="urn:oasis:names:specification:ubl:schema:xsd:QualificationApplicationRequest-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
  <cac:AdditionalDocumentReference>
    <cbc:ID>123456789-2026</cbc:ID>
    <cbc:DocumentTypeCode>TED_PIN</cbc:DocumentTypeCode>
  </cac:AdditionalDocumentReference>
</QualificationApplicationRequest>
